<Window x:Class="EasySE.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:EasySE.App"
  Title="Easy SE Mark" Icon="Assets/app.ico" Width="1280" Height="850" MinWidth="980" MinHeight="680" AllowDrop="True"
  PreviewKeyDown="WindowKeyDown" Closing="WindowClosing" Drop="WindowDrop" DragOver="WindowDragOver">
  <Grid x:Name="WorkspaceRoot" Background="#121318">
    <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="#191a20" BorderBrush="{StaticResource Edge}" BorderThickness="0,0,0,1">
      <Grid Margin="23,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="40" Height="40" CornerRadius="12" Background="#9168de" Margin="0,0,11,0">
            <Viewbox><Grid Width="32" Height="32"><Path Stroke="White" StrokeThickness="1.7" Data="M5,14 L5,18 M10,8 L10,24 M16,4 L16,28 M22,8 L22,24 M27,14 L27,18"/></Grid></Viewbox>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock FontSize="18">Easy SE <Run Foreground="#bba2f6">Mark</Run></TextBlock>
            <TextBlock Text="A Project by Jin Yishu" FontSize="9" Foreground="#81828f" HorizontalAlignment="Right" TextAlignment="Right" Margin="0,2,0,0"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
          <Border BorderBrush="#3b3944" BorderThickness="1,0,0,0" Padding="16,0,0,0"><TextBox x:Name="ProjectTitle" Width="160" MaxLength="100" Style="{StaticResource Inline}" LostKeyboardFocus="TitleCommit" KeyDown="TitleKeyDown"/></Border>
          <TextBlock x:Name="SaveDot" Text="●" FontSize="9" VerticalAlignment="Center" Foreground="#668f7c" Margin="6,0,0,0" ToolTip="保存状态"/>
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="＋ 新建" Click="NewClick" Margin="0,0,8,0"/><Button Content="打开" Click="OpenClick" Margin="0,0,8,0"/>
          <Button x:Name="SaveButton" Content="保存" Click="SaveClick" Margin="0,0,8,0"/>
          <Button x:Name="ExportButton" Content="导出 MP4" Style="{StaticResource Primary}" Click="ExportClick"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="284"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="0,0,1,0">
        <Grid><Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="24"/><RowDefinition Height="*"/><RowDefinition Height="69"/></Grid.RowDefinitions>
          <Grid Margin="17,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="音效标记" FontSize="13"/><Border Background="#2c2737" CornerRadius="4" Margin="8,0,0,0" Padding="6,2"><TextBlock x:Name="MarkerCount" Text="0" FontSize="10" Foreground="#b7a3db"/></Border></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="DuplicateButton" Content="⧉" ToolTip="复制 · Ctrl+D" Style="{StaticResource Icon}" Click="DuplicateClick"/><Button x:Name="DeleteButton" Content="×" ToolTip="删除 · Delete" Style="{StaticResource Icon}" Click="DeleteClick"/><Button x:Name="AddButton" Content="＋" ToolTip="新建标记 · M" Style="{StaticResource Icon}" Foreground="#b79bf1" Click="AddClick"/></StackPanel>
          </Grid>
          <Grid Grid.Row="1" Margin="20,0"><TextBlock Text="名称" FontSize="10" Foreground="#626471"/><TextBlock Text="开始 / 结束" HorizontalAlignment="Right" FontSize="10" Foreground="#626471"/></Grid>
          <ListBox x:Name="MarkerList" Grid.Row="2" Background="Transparent" BorderThickness="0" Padding="10,0,10,12" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="MarkerSelectionChanged">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Card" Background="#22222c" CornerRadius="6" BorderBrush="Transparent" BorderThickness="1"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="Background" Value="#25202e"/><Setter TargetName="Card" Property="BorderBrush" Value="#8d6bc9"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{Binding Color}" BorderThickness="3,0,0,0" Padding="10,9">
              <StackPanel>
                <TextBox Text="{Binding Name, Mode=OneTime}" Tag="name" MaxLength="160" Style="{StaticResource Inline}" GotKeyboardFocus="BeginInline" LostKeyboardFocus="EndInline" KeyDown="InlineKeyDown"/>
                <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="14"/><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBox Text="{Binding StartText, Mode=OneTime}" Tag="start" Style="{StaticResource Inline}" FontFamily="Consolas" FontSize="10" MaxLength="20" GotKeyboardFocus="BeginInline" LostKeyboardFocus="EndInline" KeyDown="InlineKeyDown"/>
                  <TextBlock Grid.Column="1" Text="—" VerticalAlignment="Center" Foreground="#626370" FontSize="10"/>
                  <TextBox Grid.Column="2" Text="{Binding EndText, Mode=OneTime}" Tag="end" Style="{StaticResource Inline}" FontFamily="Consolas" FontSize="10" MaxLength="20" GotKeyboardFocus="BeginInline" LostKeyboardFocus="EndInline" KeyDown="InlineKeyDown"/>
                  <TextBlock Grid.Column="3" Text="{Binding DurationText}" Foreground="{Binding Color}" FontFamily="Consolas" FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
              </StackPanel>
            </Border></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <Border Grid.Row="3" BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0"><Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
            <TextBlock Text="文字大小" Foreground="#aaa2b6" FontSize="11" VerticalAlignment="Center"/>
            <Slider x:Name="FontSlider" Grid.Column="1" Minimum="12" Maximum="288" Value="120" Margin="10,0" ValueChanged="FontChanged" PreviewMouseLeftButtonDown="FontDragBegin" PreviewMouseLeftButtonUp="FontDragEnd" LostMouseCapture="FontDragEnd"/>
            <TextBox x:Name="FontNumber" Grid.Column="2" Text="120" Height="29" TextAlignment="Center" FontFamily="Consolas" LostKeyboardFocus="FontNumberCommit" KeyDown="FontNumberKeyDown"/>
          </Grid></Border>
        </Grid>
      </Border>
      <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*" MinHeight="100"/><RowDefinition Height="62"/><RowDefinition Height="0.7*" MinHeight="200" MaxHeight="340"/></Grid.RowDefinitions>
        <Grid Margin="24,0"><TextBlock Text="视频" Foreground="#bcb5c9" FontSize="11" VerticalAlignment="Center"/><TextBlock x:Name="Resolution" Margin="40,0,0,0" Foreground="#696777" FontSize="10" FontFamily="Consolas" VerticalAlignment="Center"/>
          <Button Content="导入视频" Click="ImportClick" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" FontSize="11"/>
        </Grid>
        <Border Grid.Row="1" Margin="24,0" Background="#090a0e" BorderBrush="#2b2b36" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
          <Grid><local:PreviewSurface x:Name="Preview"/>
            <Border x:Name="EmptyState" Background="#101116"><Button Content="＋ 导入视频" Click="ImportClick" Style="{StaticResource Primary}" Padding="22,12" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
            <Border x:Name="RelinkState" Background="#d9101116" Visibility="Collapsed"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock x:Name="RelinkName" Foreground="#aaa0bd" TextAlignment="Center"/><Button Content="连接视频" Click="ImportClick" Style="{StaticResource Primary}" Margin="0,18,0,0"/></StackPanel></Border>
          </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="24,0"><Button x:Name="MuteButton" Content="♫" Style="{StaticResource Icon}" HorizontalAlignment="Left" VerticalAlignment="Center" Click="MuteClick" ToolTip="静音"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Content="|◀" Style="{StaticResource Icon}" ToolTip="上一帧 · ←" Click="PreviousClick"/><Button x:Name="PlayButton" Content="▶" Width="34" Height="34" Padding="0" Background="#30273f" BorderBrush="#4b3c63" Foreground="#c6abea" Margin="5,0" ToolTip="播放 · Space" Click="PlayClick"/><Button Content="▶|" Style="{StaticResource Icon}" ToolTip="下一帧 · →" Click="NextClick"/>
            <TextBlock x:Name="CurrentTimeText" Text="00:00.000" FontFamily="Consolas" Margin="18,0,9,0" VerticalAlignment="Center"/><TextBlock Text="/" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock x:Name="DurationText" Text="00:00.000" FontFamily="Consolas" Foreground="{StaticResource Muted}" Margin="9,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <ComboBox x:Name="Speed" HorizontalAlignment="Right" VerticalAlignment="Center" Width="56" SelectedIndex="1" SelectionChanged="SpeedChanged"><ComboBoxItem Content="0.5×"/><ComboBoxItem Content="1×"/><ComboBoxItem Content="1.5×"/><ComboBoxItem Content="2×"/></ComboBox>
        </Grid>
        <Border Grid.Row="3" Background="#17181f" BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0">
          <Grid><Grid.RowDefinitions><RowDefinition Height="51"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="时间轴" Foreground="#bfb6cf" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/><Button x:Name="UndoButton" Content="↶" Style="{StaticResource Icon}" ToolTip="撤销 · Ctrl+Z" Click="UndoClick"/><Button x:Name="RedoButton" Content="↷" Style="{StaticResource Icon}" ToolTip="重做 · Ctrl+Shift+Z" Click="RedoClick"/></StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Button x:Name="InButton" Content="起点  I" Click="InClick" Margin="0,0,8,0" FontSize="11"/><Button Content="终点  O" Click="OutClick" FontSize="11"/></StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="−" Style="{StaticResource Icon}" Click="ZoomOutClick"/><Slider x:Name="Zoom" Width="78" Minimum="0" Maximum="100" ValueChanged="ZoomChanged" ToolTip="缩放 · Ctrl+滚轮"/><Button Content="＋" Style="{StaticResource Icon}" Click="ZoomInClick"/><Button Content="↔" Style="{StaticResource Icon}" ToolTip="适配时间轴" Click="FitClick"/></StackPanel>
            </Grid>
            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Background="#1b1b24" BorderBrush="#33303d" BorderThickness="0,1,1,0"><StackPanel><TextBlock Text="时间" Height="28" Padding="12,8,0,0" FontSize="9" Foreground="#5e596a"/><TextBlock Text="▣  视频" Height="54" Padding="11,20,0,0" FontSize="10" Foreground="#8f879e"/><TextBlock Text="≋  音效" Height="54" Padding="11,20,0,0" FontSize="10" Foreground="#8f879e"/></StackPanel></Border>
              <ScrollViewer x:Name="TimelineScroll" Grid.Column="1" Style="{StaticResource TimelineScrollViewer}" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Auto" SizeChanged="TimelineResized" PreviewMouseWheel="TimelineWheel" Background="#17181f"><local:TimelineSurface x:Name="Timeline" ToolTip="Ctrl+滚轮缩放 · Shift+滚轮横移 · Alt+拖动微调"/></ScrollViewer>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Grid>
    <Border x:Name="Toast" Grid.RowSpan="2" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="20,20,20,24" Padding="16,10" Background="#32273f" BorderBrush="#76548f" BorderThickness="1" CornerRadius="6" IsHitTestVisible="False"><TextBlock x:Name="ToastText" Foreground="#e0d1ee" TextWrapping="Wrap" MaxWidth="650"/></Border>
  </Grid>
</Window>
